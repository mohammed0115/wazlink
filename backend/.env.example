# WazLink backend — development example environment (B14_11 §2).
# NO REAL CREDENTIAL BELONGS IN THIS FILE. Values here are safe placeholders.

# --- Core platform (platform-critical tier: missing/invalid => refuse to start) ---
DJANGO_SETTINGS_MODULE=config.settings.local
ENVIRONMENT=local
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=dev-only-insecure-key-please-replace-with-50-plus-characters-xxxxx
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://wazlink:wazlink_dev_pw@127.0.0.1:55433/wazlink
REDIS_URL=redis://127.0.0.1:56379/0
CELERY_BROKER_URL=redis://127.0.0.1:56379/0

# --- Browser origin contract (B14_11 §2/§3) ---
# same_origin | same_site_subdomain | cross_site   (cross_site refused in staging/production)
BROWSER_TOPOLOGY=cross_site
FRONTEND_ORIGINS=http://localhost:5173
# CORS_ALLOW_ALL_ORIGINS must never be set to True in any environment.

# --- Trust boundary (B14_31 §5). Safe default: trust no forwarded header. ---
TRUSTED_PROXY_COUNT=0

# --- Observability (optional) ---
SENTRY_DSN=

# --- Providers: ALL OPTIONAL. Wave 1 runs with every one of these absent. ---
# The domain stores the REFERENCE NAME; the resolver reads the environment at call time.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
OPENAI_API_KEY=
AI_BASE_URL=
GOOGLE_PLACES_API_KEY=
SCRAPING_API_KEY=
TAP_SECRET_KEY=
TAP_WEBHOOK_SECRET=
